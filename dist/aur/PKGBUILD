# Maintainer: Can H. Tartanoglu
pkgname=modde-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Cross-platform game mod manager for Linux"
arch=('x86_64')
url="https://codeberg.org/caniko/rs-modde"
license=('GPL-3.0-only')
depends=('openssl' 'dbus' 'wayland' 'libxkbcommon' 'vulkan-icd-loader' 'sqlite')
makedepends=('rust' 'cargo' 'pkg-config')
provides=('modde')
conflicts=('modde')
source=("git+https://codeberg.org/caniko/rs-modde.git")
sha256sums=('SKIP')

pkgver() {
  cd rs-modde
  git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || echo "$pkgver"
}

build() {
  cd rs-modde
  cargo build --release --locked
}

package() {
  cd rs-modde
  install -Dm755 "target/release/modde" "$pkgdir/usr/bin/modde"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
